// Windows 资源：可执行文件图标 + 版本信息。
//
// 这里只管"文件外面看得见的东西"（资源管理器、任务栏、属性页）。运行期的窗口图标
// 由 host/main.cpp 的 QGuiApplication::setWindowIcon() 设，资源走 qrc 里的
// assets/icons/sonora.png —— 两处尺寸分开用：.ico 要 16px 的清晰度，窗口图标要 256px 的清晰度。
//
// 路径相对于本文件所在目录（assets/）。改动图标后重跑 tools/make_icon.py。

#include <windows.h>

IDI_APPICON ICON "icons/sonora.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sonora"
            VALUE "FileDescription", "Sonora Music"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "sonora"
            VALUE "LegalCopyright", "Sonora"
            VALUE "OriginalFilename", "sonora.exe"
            VALUE "ProductName", "Sonora Music"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
