<!DOCTYPE RCC>
<RCC version="1.0">
    <!-- QML 资源清单。
         注意：xmake 没有 qt_add_qml_module 的等价物，所以这里是手工维护的
         （ARCHITECTURE.md §9.5）。新增 QML 文件必须在这里登记，否则运行时
         表现为 "qrc:/qml/xxx.qml: No such file"，而不是编译错误。
         相对路径以本文件所在目录（仓库根）为基准。 -->
    <qresource prefix="/">
        <!-- 入口与外壳 -->
        <file alias="qml/main.qml">presentation/qml/main.qml</file>
        <file alias="qml/Shell.qml">presentation/qml/Shell.qml</file>

        <!-- 设计令牌（qmldir 让 Theme/Fonts 成为单例） -->
        <file alias="qml/theme/qmldir">presentation/qml/theme/qmldir</file>
        <file alias="qml/theme/Theme.qml">presentation/qml/theme/Theme.qml</file>
        <file alias="qml/theme/Fonts.qml">presentation/qml/theme/Fonts.qml</file>

        <!-- 漫画组件 -->
        <file alias="qml/comic/MangaPanel.qml">presentation/qml/comic/MangaPanel.qml</file>
        <file alias="qml/comic/ComicButton.qml">presentation/qml/comic/ComicButton.qml</file>
        <file alias="qml/comic/ComicBubble.qml">presentation/qml/comic/ComicBubble.qml</file>
        <file alias="qml/comic/Halftone.qml">presentation/qml/comic/Halftone.qml</file>
        <file alias="qml/comic/InkSlider.qml">presentation/qml/comic/InkSlider.qml</file>
        <file alias="qml/comic/TrackRow.qml">presentation/qml/comic/TrackRow.qml</file>
        <file alias="qml/comic/SfxText.qml">presentation/qml/comic/SfxText.qml</file>
        <file alias="qml/comic/Mascot.qml">presentation/qml/comic/Mascot.qml</file>
        <file alias="qml/comic/FirstRunCard.qml">presentation/qml/comic/FirstRunCard.qml</file>
        <file alias="qml/comic/CollectionCard.qml">presentation/qml/comic/CollectionCard.qml</file>

        <!-- 页面 -->
        <file alias="qml/pages/LibraryPage.qml">presentation/qml/pages/LibraryPage.qml</file>
        <file alias="qml/pages/NowPlaying.qml">presentation/qml/pages/NowPlaying.qml</file>
        <file alias="qml/pages/OnlinePage.qml">presentation/qml/pages/OnlinePage.qml</file>
        <file alias="qml/pages/CollectionPage.qml">presentation/qml/pages/CollectionPage.qml</file>
        <file alias="qml/pages/SettingsPage.qml">presentation/qml/pages/SettingsPage.qml</file>
        <file alias="qml/pages/PlaylistsPage.qml">presentation/qml/pages/PlaylistsPage.qml</file>

        <!-- 布局部件 -->
        <file alias="qml/layout/PlayerBar.qml">presentation/qml/layout/PlayerBar.qml</file>
        <file alias="qml/layout/PageTurner.qml">presentation/qml/layout/PageTurner.qml</file>
        <file alias="qml/layout/TopBar.qml">presentation/qml/layout/TopBar.qml</file>
        <file alias="qml/comic/LoginSheet.qml">presentation/qml/comic/LoginSheet.qml</file>

        <!-- 应用图标：运行期窗口图标用；.exe 的图标在 assets/app.rc 里 -->
        <file alias="icons/sonora.png">assets/icons/sonora.png</file>

        <!-- 字体与 shader -->
        <file alias="fonts/ZCOOLKuaiLe-Subset.ttf">assets/fonts/ZCOOLKuaiLe-Subset.ttf</file>
        <file alias="shaders/dot.frag.qsb">assets/shaders/dot.frag.qsb</file>

        <!-- 翻译：lrelease translations/sonora_en.ts -qm translations/sonora_en.qm -->
        <file alias="i18n/sonora_en.qm">translations/sonora_en.qm</file>
    </qresource>
</RCC>
